<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: var(--fg-bg);">
  <div class="text-center" style="max-width: 480px; padding: 0 24px;">
    <div class="mb-4">
      <div style="width:56px;height:56px;background:var(--fg-blue-light);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:26px;">
        💰
      </div>
      <h1 class="display-6 fw-bold mb-2" style="letter-spacing:-0.5px;color:var(--fg-text);">FinanceGPT</h1>
      <p class="text-muted" style="font-size:0.95rem;">AI asistent pre fakturáciu. Jednoducho. Bezpečne.</p>
    </div>

    <% unless user_signed_in? %>
      <div class="d-flex gap-3 justify-content-center">
        <%= link_to "Prihlásiť sa", new_user_session_path, class: "btn btn-primary px-4", data: { turbo_prefetch: false } %>
        <%= link_to "Registrácia", new_user_registration_path, class: "btn btn-outline-secondary px-4", data: { turbo_prefetch: false } %>
      </div>
    <% else %>
      <div class="d-flex gap-3 justify-content-center">
        <%= link_to "Môj profil", user_path(current_user), class: "btn btn-primary px-4", data: { turbo_prefetch: false } %>
      </div>
    <% end %>
  </div>
</div>