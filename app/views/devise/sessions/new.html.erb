<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: var(--fg-bg);">
  <div class="card p-4" style="width: 100%; max-width: 400px;">
    <div class="text-center mb-4">
      <h4 class="fw-700 mb-1" style="font-size:1.4rem;letter-spacing:-0.3px;">Vitajte späť</h4>
      <p class="text-muted small">Prihláste sa do FinanceGPT</p>
    </div>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>
      <div class="mb-4">
        <%= f.label :password, "Heslo", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
      </div>
      <%= f.submit "Prihlásiť sa", class: "btn btn-primary w-100" %>
    <% end %>
    <hr class="my-3">
    <p class="text-center text-muted small mb-0">
      Nemáte účet? <%= link_to "Registrácia", new_registration_path(resource_name), class: "fw-500" %>
    </p>
  </div>
</div>