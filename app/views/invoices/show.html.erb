<div class="container py-5" style="max-width: 900px;">
  <div class="mb-4 d-flex align-items-start justify-content-between">
    <div>
      <p class="page-subtitle">Faktúra</p>
      <h1 class="page-title"><%= @invoice.invoice_name %></h1>
    </div>
    <div class="d-flex gap-2">
      <%= link_to edit_invoice_path(@invoice), class: "btn btn-warning btn-sm" do %>
        <i class="fas fa-pen me-1"></i> Upraviť
      <% end %>
      <%= link_to user_path(current_user), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="fas fa-arrow-left me-1"></i> Späť
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-4">
      <!-- Invoice header -->
      <div class="row mb-4">
        <div class="col-md-6">
          <p class="text-muted small mb-1">Číslo faktúry</p>
          <p class="fw-600 mb-0"><%= @invoice.invoice_number %></p>
        </div>
        <div class="col-md-6 text-md-end">
          <p class="text-muted small mb-1">Dátum vystavenia</p>
          <p class="fw-600 mb-0"><%= @invoice.issue_date&.strftime('%d.%m.%Y') %></p>
        </div>
      </div>

      <hr>

      <!-- Seller / Buyer / Tax Representative -->
      <div class="row g-4 mt-2">
        <% if @invoice.seller %>
          <div class="col-md-4">
            <h6 class="text-muted text-uppercase small fw-600 mb-2" style="letter-spacing:.5px">Predávajúci</h6>
            <div class="small">
              <p class="mb-1 fw-500"><%= @invoice.seller.entity_name.presence || @invoice.seller.full_name %></p>
              <p class="mb-1 text-muted"><%= @invoice.seller.street %> <%= @invoice.seller.street_note %></p>
              <p class="mb-1 text-muted"><%= @invoice.seller.postal_code %> <%= @invoice.seller.city %></p>
              <p class="mb-1 text-muted"><%= @invoice.seller.country %></p>
              <p class="mb-0 mt-2"><span class="text-muted">IČO:</span> <%= @invoice.seller.ico %></p>
              <p class="mb-0"><span class="text-muted">DIČ:</span> <%= @invoice.seller.dic %></p>
              <p class="mb-0"><span class="text-muted">IČ DPH:</span> <%= @invoice.seller.ic_dph %></p>
            </div>
          </div>
        <% end %>

        <% if @invoice.buyer %>
          <div class="col-md-4">
            <h6 class="text-muted text-uppercase small fw-600 mb-2" style="letter-spacing:.5px">Kupujúci</h6>
            <div class="small">
              <p class="mb-1 fw-500"><%= @invoice.buyer.entity_name.presence || @invoice.buyer.full_name %></p>
              <p class="mb-1 text-muted"><%= @invoice.buyer.street %> <%= @invoice.buyer.street_note %></p>
              <p class="mb-1 text-muted"><%= @invoice.buyer.postal_code %> <%= @invoice.buyer.city %></p>
              <p class="mb-1 text-muted"><%= @invoice.buyer.country %></p>
              <p class="mb-0 mt-2"><span class="text-muted">IČO:</span> <%= @invoice.buyer.ico %></p>
              <p class="mb-0"><span class="text-muted">DIČ:</span> <%= @invoice.buyer.dic %></p>
              <p class="mb-0"><span class="text-muted">IČ DPH:</span> <%= @invoice.buyer.ic_dph %></p>
            </div>
          </div>
        <% end %>

        <% if @invoice.tax_representative %>
          <div class="col-md-4">
            <h6 class="text-muted text-uppercase small fw-600 mb-2" style="letter-spacing:.5px">Daňový zástupca</h6>
            <div class="small">
              <p class="mb-1 fw-500"><%= @invoice.tax_representative.entity_name.presence || @invoice.tax_representative.full_name %></p>
              <p class="mb-1 text-muted"><%= @invoice.tax_representative.street %> <%= @invoice.tax_representative.street_note %></p>
              <p class="mb-1 text-muted"><%= @invoice.tax_representative.postal_code %> <%= @invoice.tax_representative.city %></p>
              <p class="mb-1 text-muted"><%= @invoice.tax_representative.country %></p>
              <p class="mb-0 mt-2"><span class="text-muted">IČ DPH:</span> <%= @invoice.tax_representative.ic_dph %></p>
            </div>
          </div>
        <% end %>
      </div>

      <hr class="my-4">

      <!-- Dates -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <p class="text-muted small mb-1">Dátum dodania</p>
          <p class="fw-500 mb-0"><%= @invoice.shipping_date&.strftime('%d.%m.%Y') || '—' %></p>
        </div>
        <div class="col-md-3">
          <p class="text-muted small mb-1">Dátum splatnosti</p>
          <p class="fw-500 mb-0"><%= @invoice.due_date&.strftime('%d.%m.%Y') || '—' %></p>
        </div>
        <% if @invoice.vehicle_information.present? %>
          <div class="col-md-6">
            <p class="text-muted small mb-1">Dopravný prostriedok</p>
            <p class="fw-500 mb-0"><%= @invoice.vehicle_information %></p>
          </div>
        <% end %>
      </div>

      <!-- Products table -->
      <h6 class="text-muted text-uppercase small fw-600 mb-3" style="letter-spacing:.5px">Tovar / Služba</h6>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Popis</th>
              <th>Množstvo</th>
              <th>Cena bez DPH</th>
              <th>Spolu bez DPH</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><%= @invoice.product_type %></td>
              <td><%= @invoice.product_quantity %></td>
              <td><%= number_to_currency(@invoice.unit_price_without_tax, unit: "€", format: "%n %u") %></td>
              <td><%= number_to_currency(@invoice.total_price_without_tax, unit: "€", format: "%n %u") %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Tax summary -->
      <div class="row mt-4">
        <div class="col-md-6 offset-md-6">
          <table class="table table-sm mb-0">
            <tr>
              <td class="text-muted small">Sadzba DPH</td>
              <td class="text-end"><%= @invoice.vat_rate_percentage %>%</td>
            </tr>
            <tr>
              <td class="text-muted small">Výška dane</td>
              <td class="text-end"><%= number_to_currency(@invoice.total_tax_amount_eur, unit: "€", format: "%n %u") %></td>
            </tr>
            <tr class="fw-bold">
              <td>Celkom s DPH</td>
              <td class="text-end"><%= number_to_currency((@invoice.total_price_without_tax || 0) + (@invoice.total_tax_amount_eur || 0), unit: "€", format: "%n %u") %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Bank details -->
      <% if @invoice.bank_detail %>
        <hr class="my-4">
        <h6 class="text-muted text-uppercase small fw-600 mb-3" style="letter-spacing:.5px">Bankové údaje</h6>
        <div class="row g-3 small">
          <div class="col-md-3"><span class="text-muted">Banka:</span> <%= @invoice.bank_detail.bank_name %></div>
          <div class="col-md-3"><span class="text-muted">IBAN:</span> <%= @invoice.bank_detail.iban %></div>
          <div class="col-md-3"><span class="text-muted">SWIFT:</span> <%= @invoice.bank_detail.swift %></div>
          <div class="col-md-3"><span class="text-muted">Variabilný symbol:</span> <%= @invoice.bank_detail.var_symbol %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>