<div class="container py-5" style="max-width: 860px;">
  <div class="mb-4">
    <p class="page-subtitle">Faktúry</p>
    <h1 class="page-title"><%= action_name == "new" ? "Vytvoriť faktúru" : "Upraviť faktúru" %></h1>
  </div>
  <div class="card">
    <div class="card-body p-4">
      <%= form_with(model: invoice) do |form| %>

        <div class="mb-3">
          <%= form.label "Názov faktúry", class: "form-label" %>
          <%= form.text_field :invoice_name, class: "form-control", value: sanitize(invoice.invoice_name) %>
        </div>

        <div class="mb-3">
          <%= form.label "Vyhľadanie osoby alebo firmy podľa mena", class: "form-label" %>
          <%= form.text_field :search_entity_text, class: "select2-enable form-control" %>
        </div>

        <!-- Entities: SELLER / BUYER / TAX_REPRESENTATIVE -->
        <h6 class="text-muted text-uppercase small fw-600 mb-3" style="letter-spacing:.5px">Osoby / Firmy</h6>
        <div class="row g-4">
          <% invoice.entities.each do |entity| %>
            <div class="col-md-4">
              <%= form.fields_for :entities, [entity] do |ff| %>
                <h6 class="fw-600 mb-2" style="font-size:0.85rem;"><%= ff.object.entity_type %></h6>
                <%= render 'entity', f: ff %>
              <% end %>
            </div>
          <% end %>
        </div>

        <hr class="my-4">

        <!-- Invoice details -->
        <h6 class="text-muted text-uppercase small fw-600 mb-3" style="letter-spacing:.5px">Detaily faktúry</h6>
        <div class="row g-3">
          <div class="col-md-6">
            <%= form.label "Číslo faktúry", class: "form-label" %>
            <%= form.text_field :invoice_number, class: "form-control", value: sanitize(invoice.invoice_number) %>
          </div>
          <div class="col-md-6">
            <%= form.label "Dátum vystavenia faktúry", class: "form-label" %>
            <%= form.date_field :issue_date, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= form.label "Dodací/Prepravný dátum", class: "form-label" %>
            <%= form.date_field :shipping_date, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= form.label "Dátum splatnosti", class: "form-label" %>
            <%= form.date_field :due_date, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= form.label "Údaje o dodanom novom dopravnom prostriedku", class: "form-label" %>
            <%= form.text_field :vehicle_information, class: "form-control", value: sanitize(invoice.vehicle_information) %>
          </div>
        </div>

        <div class="row g-3 mt-2">
          <div class="col-md-6">
            <div class="form-check">
              <%= form.check_box :self_issued_invoice, class: "form-check-input" %>
              <%= form.label "Vyhotovenie faktúry odberateľom", class: "form-check-label" %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-check">
              <%= form.check_box :tax_liability_shift, class: "form-check-input" %>
              <%= form.label "Prenesenie daňovej povinnosti", class: "form-check-label" %>
            </div>
          </div>
        </div>

        <hr class="my-4">

        <!-- Product details -->
        <h6 class="text-muted text-uppercase small fw-600 mb-3" style="letter-spacing:.5px">Tovar / Služba</h6>
        <div class="row g-3">
          <div class="col-md-4">
            <%= form.label "Úprava zdaňovania prirážky", class: "form-label" %>
            <%= form.text_field :tax_adjustment_type, {class: "form-control", placeholder: "prirážka: €", value: sanitize(invoice.tax_adjustment_type)} %>
          </div>
          <div class="col-md-4">
            <%= form.label "Druh dodaného tovaru", class: "form-label" %>
            <%= form.text_field :product_type, class: "form-control", value: sanitize(invoice.product_type) %>
          </div>
          <div class="col-md-4">
            <%= form.label "Množstvo dodaného tovaru", class: "form-label" %>
            <%= form.number_field :product_quantity, {class: "form-control", placeholder: "ks"} %>
          </div>
          <div class="col-md-3">
            <%= form.label "Jednotková cena bez DPH", class: "form-label" %>
            <%= form.text_field :unit_price_without_tax, {class: "form-control", placeholder: "€"} %>
          </div>
          <div class="col-md-3">
            <%= form.label "Celková cena bez DPH", class: "form-label" %>
            <%= form.text_field :total_price_without_tax, {class: "form-control", placeholder: "€"} %>
          </div>
          <div class="col-md-3">
            <%= form.label "Sadzba DPH (%)", class: "form-label" %>
            <%= form.text_field :vat_rate_percentage, {class: "form-control", placeholder: "%"} %>
          </div>
          <div class="col-md-3">
            <%= form.label "Výška dane spolu", class: "form-label" %>
            <%= form.text_field :total_tax_amount_eur, {class: "form-control", placeholder: "€"} %>
          </div>
        </div>

        <hr class="my-4">

        <!-- Bank details -->
        <h6 class="text-muted text-uppercase small fw-600 mb-3" style="letter-spacing:.5px">Bankové údaje</h6>
        <%= form.fields_for :bank_detail do |bd| %>
          <div class="row g-3">
            <div class="col-md-4">
              <%= bd.label :bank_name, "Banka", class: "form-label" %>
              <%= bd.text_field :bank_name, {class: "form-control", placeholder: "napr. Tatra Banka", value: sanitize(invoice.bank_detail.bank_name)} %>
            </div>
            <div class="col-md-4">
              <%= bd.label :iban, "IBAN", class: "form-label" %>
              <%= bd.text_field :iban, {class: "form-control", placeholder: "SK89 7500 0000 0000 1234 5671", value: sanitize(invoice.bank_detail.iban)} %>
            </div>
            <div class="col-md-4">
              <%= bd.label :swift, "SWIFT Kód", class: "form-label" %>
              <%= bd.text_field :swift, class: "form-control", value: sanitize(invoice.bank_detail.swift) %>
            </div>
            <div class="col-md-4">
              <%= bd.label :var_symbol, "Variabilný symbol", class: "form-label" %>
              <%= bd.text_field :var_symbol, class: "form-control", value: sanitize(invoice.bank_detail.var_symbol) %>
            </div>
            <div class="col-md-4">
              <%= bd.label :konst_symbol, "Konštantný symbol", class: "form-label" %>
              <%= bd.text_field :konst_symbol, class: "form-control", value: sanitize(invoice.bank_detail.konst_symbol) %>
            </div>
          </div>
        <% end %>

        <div class="d-none">
          <%= form.number_field :user_id, type: :hidden, class: "form-control", value: current_user.id %>
        </div>

        <div class="d-flex gap-2 mt-4">
          <%= form.submit "Uložiť", class: "btn btn-primary" %>
          <%= link_to "Späť", user_path(current_user), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script type="text/javascript" charset="utf-8">
    $(document).ready(function(){
        $("#ico-seller").on("focusout", function (){
            let value = $(this).val();

            if(value != null && value !== "")
            {
                $.ajax({
                    url: "http://localhost:3000/api/search",
                    accepts: {
                        text: "application/json"
                    },
                    data: { ico: value },
                    type: "get"
                }).done(function(responseData) {
                    $("#first_name-seller").val(responseData['first_name']);
                    $("#last_name-seller").val(responseData['last_name']);
                    $("#dic-seller").val(responseData['dic']);
                    $("#ic_dph-seller").val(responseData['ic_dph']);
                    $("#entity_name-seller").val(responseData['entity_name']);

                    const adress = responseData['addresses'][0];
                    $("#street-seller").val(adress['street']);
                    $("#postal_code-seller").val(adress['postal_code']);

                    const street_notes = [];
                    if(adress['building_number'] != null)
                    {
                        street_notes.push(adress['building_number'])
                    }
                    if(adress['reg_number'] != null)
                    {
                        street_notes.push(adress['reg_number'])
                    }
                    const street_note = street_notes.join('/');
                    $("#street_note-seller").val(String(street_note));

                    const municipality = adress['municipality'];
                    $("#city-seller").val(municipality['name']);

                    const country = adress['country'];
                    $("#country-seller").val(country['name']);
                }).fail(function() {
                    console.log("Failed");
                });
            }
        });

        $("#ico-buyer").on("focusout", function (){
            let value = $(this).val();

            if(value != null && value !== "")
            {
                $.ajax({
                    url: "http://localhost:3000/api/search",
                    accepts: {
                        text: "application/json"
                    },
                    data: { ico: value },
                    type: "get"
                }).done(function(responseData) {
                    $("#first_name-buyer").val(responseData['first_name']);
                    $("#last_name-buyer").val(responseData['last_name']);
                    $("#dic-buyer").val(responseData['dic']);
                    $("#ic_dph-buyer").val(responseData['ic_dph']);
                    $("#entity_name-buyer").val(responseData['entity_name']);

                    const adress = responseData['addresses'][0];
                    $("#street-buyer").val(adress['street']);
                    $("#postal_code-buyer").val(adress['postal_code']);

                    const street_notes = [];
                    if(adress['building_number'] != null)
                    {
                        street_notes.push(adress['building_number'])
                    }
                    if(adress['reg_number'] != null)
                    {
                        street_notes.push(adress['reg_number'])
                    }
                    const street_note = street_notes.join('/');
                    $("#street_note-buyer").val(String(street_note));

                    const municipality = adress['municipality'];
                    $("#city-buyer").val(municipality['name']);

                    const country = adress['country'];
                    $("#country-buyer").val(country['name']);
                }).fail(function() {
                    console.log("Failed");
                });
            }
        });

        $("#ic_dph-tax_representative").on("focusout", function (){
            let value = $(this).val();

            if(value != null && value !== "")
            {
                $.ajax({
                    url: "http://localhost:3000/api/tax_rep",
                    accepts: {
                        text: "application/json"
                    },
                    data: { ic_dph: value },
                    type: "get"
                }).done(function(responseData) {
                    $("#first_name-tax_representative").val(responseData['first_name']);
                    $("#last_name-tax_representative").val(responseData['last_name']);
                    $("#entity_name-tax_representative").val(responseData['entity_name']);

                    const adress = responseData['addresses'][0];
                    $("#street-tax_representative").val(adress['street']);
                    $("#postal_code-tax_representative").val(adress['postal_code']);

                    const street_notes = [];
                    if(adress['building_number'] != null)
                    {
                        street_notes.push(adress['building_number'])
                    }
                    if(adress['reg_number'] != null)
                    {
                        street_notes.push(adress['reg_number'])
                    }
                    const street_note = street_notes.join('/');
                    $("#street_note-tax_representative").val(String(street_note));

                    const municipality = adress['municipality'];
                    $("#city-tax_representative").val(municipality['name']);

                    const country = adress['country'];
                    $("#country-tax_representative").val(country['name']);
                }).fail(function() {
                    console.log("Failed");
                });
            }
        });

        $('.select2-enable').select2({
            ajax: {
                url: 'http://localhost:3000/api/search_by_name',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        search: params.term // search term
                    };
                },
                processResults: function (data) {
                    return {
                        results: $.map(data, function(item) {
                            return {
                                text: item.first_name + ' ' + item.last_name + ' (' + item.entity_name + ')',
                                id: item.id,
                                data: item
                            }
                        })
                    };
                },
                cache: true
            },
            minimumInputLength: 2
        }).on('select2:select', function (e) {
            var data = e.params.data.data;
            console.log(data);

            $("#first_name-buyer").val(data.first_name);
            $("#last_name-buyer").val(data.last_name);
            $("#ico-buyer").val(data.ico);
            $("#dic-buyer").val(data.dic);
            $("#ic_dph-buyer").val(data.ic_dph);
            $("#entity_name-buyer").val(data.entity_name);

            if (data.addresses && data.addresses.length > 0) {
                const adress = data.addresses[0];
                $("#street-buyer").val(adress.street);
                $("#postal_code-buyer").val(adress.postal_code);

                const street_notes = [];
                if(adress.building_number != null)
                {
                    street_notes.push(adress.building_number)
                }
                if(adress.reg_number != null)
                {
                    street_notes.push(adress.reg_number)
                }
                const street_note = street_notes.join('/');
                $("#street_note-buyer").val(String(street_note));

                const municipality = adress.municipality;
                $("#city-buyer").val(municipality.name);

                const country = adress.country;
                $("#country-buyer").val(country.name);
            }
        });
    });
</script>