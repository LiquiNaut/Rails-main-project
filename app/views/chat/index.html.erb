<% content_for :head do %>
  <%= stylesheet_link_tag "chat", "data-turbo-track": "reload" %>
<% end %>

<%# FinanceGPT Chat — Full-viewport layout %>

<div class="chat-layout"
     data-controller="chat"
     data-chat-chat-ask-path-value="<%= chat_ask_path %>"
     data-chat-chat-id-value="<%= @chat_record&.id %>">

  <%# ── SIDEBAR ── %>
  <aside class="chat-sidebar">
    <div class="chat-sidebar-header">
      <%= button_to chat_new_path, method: :post, class: "btn-new-chat" do %>
        <i class="fas fa-plus"></i>
        <span>Nový chat</span>
      <% end %>
    </div>

    <div class="chat-sidebar-list">
      <% if @chats.present? %>
        <% @chats.each do |chat| %>
          <% first_msg = chat.messages.where(role: 'user').order(:created_at).first %>
          <% label = first_msg ? first_msg.content.to_s.truncate(28) : chat.created_at.strftime("%d.%m. %H:%M") %>
          <div class="chat-sidebar-item <%= 'active' if @chat_record&.id == chat.id %>">
            <%= link_to label, chat_show_path(chat), class: "conv-link" %>
            <%= button_to "/chat/#{chat.id}", method: :delete,
                  class: "btn-delete",
                  data: { confirm: "Naozaj zmazať?" } do %>
              <i class="fas fa-xmark"></i>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted small text-center p-3" style="opacity:.5">
          Žiadne konverzácie
        </p>
      <% end %>
    </div>
  </aside>

  <%# ── MAIN CHAT AREA ── %>
  <div class="chat-main">

    <%# Header %>
    <div class="chat-header">
      <div class="chat-header-title">
        <span class="ai-dot"></span>
        Chat s AI
      </div>
      <span class="text-muted small">FinanceGPT &middot; <%= @chat_record&.model&.name || 'AI' %></span>
    </div>

    <%# AI Notice — dismissible %>
    <%= render "shared/ai_privacy_notice" %>

    <%# Messages %>
    <div class="chat-messages" id="chatMessages" data-chat-target="messages">
      <% if @chat_history.blank? %>
        <div class="chat-empty">
          <div class="chat-empty-icon"><i class="fas fa-robot"></i></div>
          <h3>Ako vám môžem pomôcť?</h3>
          <p>Opýtajte sa na svoje faktúry, príjmy, výdavky alebo cashflow.</p>
          <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
            <% ["Koľko mám faktúr?", "Aký je môj cashflow?", "Kto mi dlhuje?"].each do |q| %>
              <button class="chat-suggestion" onclick="fillInput(this.textContent.trim())">
                <%= q %>
              </button>
            <% end %>
          </div>
        </div>
      <% else %>
        <% @chat_history.each do |msg| %>
          <% next if msg[:content].blank? || msg[:role] == 'system' %>
          <% if msg[:role] == 'tool' %>
            <% begin %>
              <% chart_data = JSON.parse(msg[:content]) %>
              <% if chart_data.is_a?(Hash) && chart_data['chart_type'] %>
                <div data-chart="<%= h(msg[:content]) %>"
                     class="alert alert-light border small text-muted p-2"
                     style="max-width: 500px;">
                  Loading chart...
                </div>
              <% end %>
            <% rescue => e %>
              <!-- JSON Parse Error: <%= e.message %> -->
            <% end %>
          <% else %>
            <div class="message <%= msg[:role] == 'user' ? 'user' : 'assistant' %>">
              <div class="message-avatar">
                <% if msg[:role] == 'user' %>
                  <i class="fas fa-user"></i>
                <% else %>
                  <i class="fas fa-robot"></i>
                <% end %>
              </div>
              <div class="message-bubble">
                <%= sanitize msg[:content] %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# Input %>
    <div class="chat-input-area">
      <div class="chat-input-row">
        <label for="prompt-input" class="visually-hidden">Správa</label>
        <textarea id="prompt-input"
                  class="chat-textarea"
                  placeholder="Napíšte správu… (Enter = odoslať)"
                  rows="1"
                  data-chat-target="input"
                  data-action="keypress->chat#sendMessageOnEnter"
                  autocomplete="off"></textarea>
        <button class="chat-send-btn"
                data-chat-target="sendButton"
                data-action="click->chat#sendMessage">
          <i class="fas fa-arrow-up"></i>
        </button>
      </div>
      <p class="text-center text-muted mt-2" style="font-size:11px;opacity:.6;">
        AI môže robiť chyby. Overte dôležité finančné informácie.
      </p>
    </div>

  </div>
</div>

<script>
  const msgs = document.getElementById('chatMessages');
  if (msgs) msgs.scrollTop = msgs.scrollHeight;

  function fillInput(text) {
    const ta = document.querySelector('.chat-textarea');
    if (ta) { ta.value = text; ta.focus(); }
  }

  document.querySelectorAll('.chat-textarea').forEach(ta => {
    ta.addEventListener('input', () => {
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight, 140) + 'px';
    });
  });
</script>
